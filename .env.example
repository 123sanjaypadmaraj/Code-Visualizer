GROQ_API_KEY=
GEMINI_API_KEY=
# optional extra free providers, used as fallbacks (more providers = more reliable autocomplete)
# CEREBRAS_API_KEY=       # https://cloud.cerebras.ai (free tier)
# OPENROUTER_API_KEY=     # https://openrouter.ai (models ending in :free cost nothing)
# optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# optional tuning
# RATE_LIMIT_PER_MIN=20   # per-IP requests/minute to /api/analyze
# LLM_TIMEOUT_MS=25000   # per-provider timeout before falling back
# COMPLETE_RATE_LIMIT_PER_MIN=40   # per-IP requests/minute to /api/complete (AI autocomplete)
# COMPLETE_TIMEOUT_MS=8000         # per-provider timeout for autocomplete
# GROQ_COMPLETE_MODEL=llama-3.1-8b-instant
# GEMINI_COMPLETE_MODEL=gemini-2.5-flash
